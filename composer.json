{
    "name": "nwidart/metrics-store",
    "description": "Cross-process aggregation for OpenTelemetry metrics in shared-nothing PHP runtimes such as PHP-FPM.",
    "keywords": [
        "opentelemetry",
        "metrics",
        "php-fpm",
        "prometheus",
        "otlp",
        "redis"
    ],
    "homepage": "https://github.com/nWidart/metrics-store",
    "support": {
        "issues": "https://github.com/nWidart/metrics-store/issues",
        "source": "https://github.com/nWidart/metrics-store"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolas Widart",
            "email": "n.widart@gmail.com",
            "homepage": "https://nwidart.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nyholm/psr7": "^1.6",
        "open-telemetry/api": "^1.12",
        "open-telemetry/sdk": "^1.17",
        "symfony/http-client": "^5.4"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "open-telemetry/exporter-otlp": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "predis/predis": "^2.3|^3.0"
    },
    "suggest": {
        "ext-redis": "Required by the Redis store when using the phpredis client.",
        "predis/predis": "Required by the Redis store when using the predis client."
    },
    "autoload": {
        "psr-4": {
            "Nwidart\\MetricsStore\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nwidart\\MetricsStore\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
